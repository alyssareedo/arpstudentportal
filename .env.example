# ============================================================
# Frontend (Vite) — required for the app to start
# ============================================================
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-anon-or-publishable-key>"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# Legacy alias — also accepted if you prefer this name:
# VITE_SUPABASE_ANON_KEY="<your-anon-or-publishable-key>"

# ============================================================
# Edge function secrets — DO NOT put in this file.
# Set them in Supabase dashboard → Project Settings → Edge Functions → Secrets
# ============================================================
# SUPABASE_URL                 (auto-provided by Supabase runtime)
# SUPABASE_ANON_KEY            (auto-provided)
# SUPABASE_SERVICE_ROLE_KEY    (auto-provided — used by admin-create-student & seed-students)
# LOVABLE_API_KEY              (REQUIRED by seed-toeic-questions; replace with your own
#                               LLM provider key like OPENAI_API_KEY if leaving Lovable
#                               and update supabase/functions/seed-toeic-questions/index.ts)
