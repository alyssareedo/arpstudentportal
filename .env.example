# ---- Frontend (Vite) ----
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-anon-or-publishable-key>"
# Optional (only needed if you also want to reference the project ref in code)
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# ---- Edge Functions (set as Supabase secrets, NOT in this file) ----
# SUPABASE_URL                 - auto-provided by Supabase runtime
# SUPABASE_ANON_KEY            - auto-provided
# SUPABASE_SERVICE_ROLE_KEY    - auto-provided
# LOVABLE_API_KEY              - required by seed-toeic-questions (Lovable AI Gateway).
#                                If migrating away from Lovable, replace with your own
#                                LLM provider key (e.g. OPENAI_API_KEY) and update the function.
