# Copy this file to keystore.properties and fill in the real values.
# keystore.properties is listed in .gitignore, so it is never uploaded to GitHub.
#
# storeFile     - path to your upload key, relative to this project's folder
# storePassword - the password you chose when you created the key
# keyAlias      - the alias you chose when you created the key
# keyPassword   - the password for that alias (often the same as storePassword)

storeFile=arp-upload.keystore
storePassword=CHANGE_ME
keyAlias=arp-upload
keyPassword=CHANGE_ME
